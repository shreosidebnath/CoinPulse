<div class="min-h-screen bg-gradient-to-br from-cyber-darker via-cyber-dark to-cyber-darker flex items-center justify-center px-4 py-8">
  <div class="max-w-md w-full">
    <!-- Logo/Title -->
    <div class="text-center mb-6">
      <h1 class="text-5xl font-bold mb-2">
        <span class="text-neon-green">Coin</span><span class="text-neon-blue">Pulse</span>
      </h1>
      <p class="text-gray-400">Real-Time Crypto Portfolio Tracker</p>
    </div>

    <!-- Demo Button - TOP PRIORITY -->
    <div class="mb-6">
      <%= button_to demo_path, method: :post, class: "w-full bg-neon-green text-black px-8 py-4 rounded-lg hover:shadow-lg hover:shadow-neon-green/50 transition-all duration-300 font-bold text-lg" do %>
        <span class="mr-2"></span> Try Demo - No Sign Up Required!
      <% end %>
    </div>

    <!-- Divider -->
    <div class="flex items-center my-6">
      <div class="flex-1 border-t border-gray-700"></div>
      <span class="px-4 text-gray-500 text-sm">or sign in</span>
      <div class="flex-1 border-t border-gray-700"></div>
    </div>

    <!-- Sign In Card -->
    <div class="bg-cyber-dark border border-neon-blue/30 rounded-2xl p-6 shadow-2xl shadow-neon-blue/10">
      <h2 class="text-xl font-bold text-white mb-4">Sign In to Your Account</h2>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
        <div>
          <%= f.label :email, class: "block text-sm font-semibold text-neon-green mb-2" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", 
              class: "w-full bg-cyber-darker border border-neon-blue/30 text-white rounded-lg px-4 py-3 focus:border-neon-blue focus:outline-none focus:shadow-lg focus:shadow-neon-blue/20 transition-all" %>
        </div>

        <div>
          <%= f.label :password, class: "block text-sm font-semibold text-neon-green mb-2" %>
          <%= f.password_field :password, autocomplete: "current-password", 
              class: "w-full bg-cyber-darker border border-neon-blue/30 text-white rounded-lg px-4 py-3 focus:border-neon-blue focus:outline-none focus:shadow-lg focus:shadow-neon-blue/20 transition-all" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "mr-2" %>
            <%= f.label :remember_me, class: "text-gray-400 text-sm" %>
          </div>
        <% end %>

        <div>
          <%= f.submit "Sign In", 
    class: "w-full bg-gradient-to-r from-neon-green to-neon-blue text-black px-6 py-3 rounded-lg hover:shadow-lg hover:shadow-neon-green/50 transition-all duration-300 font-bold cursor-pointer" %>
        </div>
      <% end %>

      <!-- Links -->
      <div class="mt-4 pt-4 border-t border-gray-700 space-y-2 text-center text-sm">
        <%= link_to "Create new account", new_registration_path(resource_name), class: "block text-neon-blue hover:text-neon-green transition-colors" %>
        <%= link_to "Forgot password?", new_password_path(resource_name), class: "block text-gray-400 hover:text-neon-blue transition-colors" %>
      </div>
    </div>
  </div>
</div>